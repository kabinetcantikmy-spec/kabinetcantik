# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- WhatsApp (MVP: wa.me deep link) ----
# Nombor sales dalam format antarabangsa tanpa '+', cth 60123456789
NEXT_PUBLIC_WHATSAPP_SALES=60123456789

# ---- WhatsApp Business API (Meta Cloud API) ----
# Dari Meta: WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Token rawak yang kau tetapkan; masukkan sama dalam Meta webhook config
WHATSAPP_VERIFY_TOKEN=
# Nama template diluluskan Meta (cipta di Meta dengan nama sama)
WA_TPL_LEAD=lead_welcome
WA_TPL_STAGE=stage_update
WA_TPL_PAYMENT=payment_received
WA_TPL_APPOINTMENT=appointment_reminder
WA_TPL_REVIEW=project_review
WA_TPL_LANG=ms

# ---- Brand / kontak (papar di footer) ----
NEXT_PUBLIC_SHOWROOM_ADDRESS=
NEXT_PUBLIC_SERVICE_AREA=Klang Valley

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_FROM=KabinetCantik <noreply@kabinetcantik.com>
# Emel sales untuk notifikasi dalaman
SALES_NOTIFY_EMAIL=

# ---- Storage (dokumen sulit) ----
SUPABASE_DOCS_BUCKET=dokumen

# ---- Payments (CHIP Collect) ----
CHIP_BRAND_ID=
CHIP_SECRET_KEY=
# Public key (PEM) untuk verify webhook signature CHIP
CHIP_WEBHOOK_PUBLIC_KEY=
# Base API CHIP (default sandbox/live gateway)
CHIP_API_BASE=https://gate.chip-in.asia/api/v1

# ---- App URL (untuk redirect selepas bayaran) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
